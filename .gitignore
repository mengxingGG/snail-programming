# 蜗牛编程 — Git 忽略规则

# ─── 依赖 ───
node_modules/

# ─── 构建产物 ───
dist/
release/
*.tsbuildinfo

# ─── 数据库 ───
*.db
*.db-journal
*.db-wal

# ─── 环境配置 ───
.env
.env.local

# ─── 代理配置（含凭证，禁止入库） ───
台湾直连-固定出口.yaml

# ─── 运行/审计产生的临时数据 ───
audit_report.json
books.csv
demo.txt
log.txt
memos.json
posts.json
report.txt
temp.py
temp.ts
tmp/

# ─── 工具目录 ───
.dbg/
.reasonix/

# ─── 系统文件 ───
.DS_Store
Thumbs.db
desktop.ini

# ─── 日志 ───
*.log
npm-debug.log*

# ─── IDE ───
.vscode/
.idea/
*.swp
*.swo
*~
